{
  "name": "webmoguls-google-buisness-backend",
  "version": "1.0.0",
  "description": "WebMoguls Google Business Backend - Elysia.js + Drizzle ORM + MySQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.2.0",
    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.2.0",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
